model Device {
  id String @id @default(uuid())

  userId String

  /**
   * Store a fingerprint/hash.
   * Do not store unnecessary raw device identifiers.
   */
  fingerprint String

  name      String?
  userAgent String?
  ipAddress String?
  platform  String?

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([lastSeenAt])
}

model Session {
  id String @id @default(uuid())

  userId   String
  deviceId String?
  clientId String?

  status SessionStatus @default(ACTIVE)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  expiresAt DateTime

  lastSeenAt DateTime?

  revokedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tokenFamilies TokenFamily[]

  @@index([userId])
  @@index([deviceId])
  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
}
